{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "www/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    },
    "dist": {
      "cache": false
    },
    "apk": {
      "cache": false,
      "passThroughEnv": [
        "ANDROID_HOME",
        "ANDROID_SDK_ROOT",
        "JAVA_HOME"
      ]
    }
  },
  "globalEnv": [
    "NODE_ENV"
  ]
}
