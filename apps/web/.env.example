# SQLite database file, relative to the prisma/ directory
DATABASE_URL="file:./dev.db"
# Secret used to sign session JWTs — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# Cloudflare Turnstile (bot protection on login/register).
# Get keys at https://dash.cloudflare.com -> Turnstile.
# For local dev you can use Cloudflare's dummy keys:
#   site key   1x00000000000000000000AA (always passes)
#   secret key 1x0000000000000000000000000000000AA (always passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
